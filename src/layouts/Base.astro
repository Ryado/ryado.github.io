---
import "../styles/global.css";
import serifFont from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url";
import { SITE } from "../site";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  type?: "website" | "article";
}

const { title, description = SITE.description, canonical, type = "website" } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.headline}`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const nav = [
  { href: "/#thesis", label: "Thesis", match: "/#thesis" },
  { href: "/#essays", label: "Essays", match: "/writing" },
  { href: "/#launches", label: "Launches", match: "/#launches" },
  { href: "/#papers", label: "Papers", match: "/#papers" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="author" content={SITE.name} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121316" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Writing`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <script is:inline>
      // The site's only JavaScript: apply a saved light/dark preference before paint.
      try {
        var t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <div class="wrap">
      <header class="site-header">
        <a class="home" href="/" aria-current={path === "/" ? "page" : undefined}>{SITE.name}</a>
        <nav aria-label="Main">
          <ul>
            {
              nav.map((n) => (
                <li>
                  <a href={n.href} aria-current={path.startsWith(n.match) ? "page" : undefined}>
                    {n.label}
                  </a>
                </li>
              ))
            }
            <li>
              <button class="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
                <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
                <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
              </button>
            </li>
          </ul>
        </nav>
      </header>

      <main id="content">
        <slot />
      </main>

      <footer class="site-footer">
        <ul>
          <li><a href={`mailto:${SITE.email}`}>Email</a></li>
          <li><a href={SITE.linkedin} rel="me">LinkedIn</a></li>
          <li><a href={SITE.github} rel="me">GitHub</a></li>
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </footer>
    </div>
    <script is:inline>
      document.querySelector(".theme-toggle").addEventListener("click", function () {
        var root = document.documentElement;
        var dark = root.dataset.theme
          ? root.dataset.theme === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
        var next = dark ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch (e) {}
      });
    </script>
  </body>
</html>
