---
import Base from "../layouts/Base.astro";

// TODO(Ryadh): fill in the one-line descriptions and links.
const investments = [
  { name: "Starling", batch: "YC", url: "", description: "" },
  { name: "Pelica Health", batch: "YC", url: "", description: "" },
];
---

<Base title="Investing" description="Angel investments by Ryadh Dahimene.">
  <h1>Investing</h1>
  <p>I make a few small angel investments in early-stage companies.</p>

  <ul class="plain-list">
    {
      investments.map((i) => (
        <li>
          <strong>{i.url ? <a href={i.url}>{i.name}</a> : i.name}</strong>{" "}
          <span class="tag">{i.batch}</span>
          <br />
          {i.description ? i.description : <span class="placeholder">One-line description coming soon.</span>}
        </li>
      ))
    }
  </ul>
</Base>
